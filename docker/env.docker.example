# Copiar a .env en la raíz del proyecto para usar docker compose en local.
# En producción este archivo vive SOLO en el servidor (nunca en git).

ENVIRONMENT=development

DB_NAME=colfe_db
DB_USER=colfe_app
DB_PASS=cambie-esta-clave-local-1
MYSQL_ROOT_PASSWORD=cambie-esta-clave-root-1

WEB_PORT=8080
SESSION_TIMEOUT=3600
API_TOKEN_TTL=86400
CORS_ALLOWED_ORIGINS=

# IP real del cliente detrás de un proxy (afecta el bloqueo de intentos de login)
REAL_IP_HEADER=X-Forwarded-For
TRUSTED_PROXY_CIDR=172.16.0.0/12
