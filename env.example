# Copiar a .env (solo desarrollo local). En Docker/producción se definen como
# variables de entorno del servidor y el .env no se versiona nunca.

# Entorno: production (por defecto) | staging | development
ENVIRONMENT=development

# Base de datos (OBLIGATORIAS, sin valores por defecto)
DB_HOST=127.0.0.1
DB_NAME=colfe_db
DB_USER=
DB_PASS=

# Sesión web: inactividad máxima en segundos (por defecto 3600 = 1 h)
SESSION_TIMEOUT=3600

# API móvil
# Vigencia del token en segundos (por defecto 86400 = 24 h)
API_TOKEN_TTL=86400
# Orígenes web autorizados para CORS, separados por coma. Vacío = ninguno
# (la app Android nativa no necesita CORS)
CORS_ALLOWED_ORIGINS=
